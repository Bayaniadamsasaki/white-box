# AI Configuration - VPS Optimized (gunakan model kecil untuk VPS)
OLLAMA_MODEL=llama3.2:1b     # Model kecil 1.3GB untuk VPS (ganti ke 3b jika RAM cukup)
OLLAMA_BASE_URL=http://localhost:11434

# VPS-Optimized AI Settings (Resource-friendly)
AI_NUM_PREDICT=400           # Lebih kecil untuk VPS resource terbatas
AI_TEMPERATURE=0.2           # Sedikit lebih tinggi untuk variasi 
AI_TIMEOUT=180               # Timeout lebih pendek untuk VPS
AI_RETRY_ATTEMPTS=2          # Sedikit retry untuk hemat resource
AI_MIN_RESPONSE_LENGTH=150   # Standard minimum

# VPS Mode (Server Ubuntu dengan Ollama)
DISABLE_AI_ANALYSIS=false    # false = gunakan AI analysis (Ollama sudah terinstall)
UBUNTU_MODE=true             # true = optimasi khusus Ubuntu
FAST_MODE=false              # false = prioritas kualitas AI
