# Telegram Configuration (Required)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# AI Configuration (Choose one)

# Option 1: Local Ollama AI (Recommended - Privacy & Free)
USE_OLLAMA=true
OLLAMA_MODEL=deepseek-r1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Option 2: Cloud Gemini AI (Optional - Requires API Key)
GEMINI_API_KEY=your_gemini_api_key_here

# Setup Instructions:
# 1. For Telegram: Chat with @BotFather to create bot, @userinfobot for chat ID
# 2. For Ollama: Install from ollama.ai, run "ollama pull deepseek-r1:8b", then "ollama serve"
# 3. For Gemini: Get API key from https://makersuite.google.com/app/apikey
# 4. Test setup: python test_ollama.py (for Ollama) or python utils.py (for Gemini)
