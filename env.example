AI_MIN_RESPONSE_LENGTH=300   # Panjang minimum respons dianggap lengkap

# Emergency Mode (Untuk server lambat)
DISABLE_AI_ANALYSIS=false    # true = hanya analisis berbasis aturan
UBUNTU_MODE=false            # true = optimasi khusus Ubuntu
FAST_MODE=false              # true = prioritas kecepatan
